{
  "name": "behavioral-archaeologist",
  "version": "0.1.0",
  "description": "Behavioral Archaeologist / AI Psychologist agent — Agentic AI SF Hackathon backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch backend/server.ts",
    "build": "tsc",
