# =============================================================================
# Behavioral Archaeologist — Environment Variables
# Copy to .env and fill in your hackathon sponsor API keys.
# =============================================================================

# Server
PORT=3000
SERVER_PUBLIC_URL=https://your-public-server.example.com

# Butterbase (sponsor — database, auth, encrypted storage, AI gateway)
# App: happyscooby → https://happyscooby.butterbase.dev
# Without DATABASE_URL below, the app uses Butterbase REST Data API automatically.
BUTTERBASE_API_URL=https://api.butterbase.ai
BUTTERBASE_API_KEY=your_butterbase_api_key_here
BUTTERBASE_PROJECT_ID=app_bc9eumvexyn3
# Optional: direct Postgres from Dashboard → Apps → happyscooby → Overview
DATABASE_URL=postgresql://user:password@localhost:5432/behavioral_archaeologist

# OpenAI — GPT-4o Vision (routed via butterbase/ai-gateway.ts for facial expression extraction)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic — psych analysis via Butterbase AI gateway (anthropic/claude-sonnet-4.6)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# XTrace (sponsor — long-term behavioral memory layer)
XTRACE_API_URL=https://api.xtrace.ai
XTRACE_API_KEY=your_xtrace_api_key_here

# Photon / Spectrum (sponsor — Telegram messaging delivery via spectrum-ts)
# Dashboard: https://app.photon.codes — Settings → Project ID + Project Secret
PHOTON_PROJECT_ID=your_photon_project_id_here
PHOTON_PROJECT_SECRET=your_photon_project_secret_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# RocketRide (sponsor — visual AI pipeline orchestration)
ROCKETRIDE_URI=https://cloud.rocketride.ai
ROCKETRIDE_APIKEY=your_rocketride_api_key_here
