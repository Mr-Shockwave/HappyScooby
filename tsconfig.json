{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": [
    "backend/**/*",
    "butterbase/**/*",
    "rocketride/**/*",
    "xtrace/**/*",
    "photon/**/*",
    "hardware-bridge/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}
